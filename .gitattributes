# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Binary files
*.glb binary
*.jpg binary
*.jpeg binary
*.png binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
